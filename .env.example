# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder values.
# MODEL_PROVIDER selects the generator backend: "openai" (default) or "gemini".
MODEL_PROVIDER=gemini

# OpenAI provider (used when MODEL_PROVIDER=openai).
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini provider (used when MODEL_PROVIDER=gemini) via Google's
# OpenAI-compatible endpoint. Use a model that does not spend the whole output
# budget on reasoning tokens (e.g. gemini-3.1-flash-lite).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
